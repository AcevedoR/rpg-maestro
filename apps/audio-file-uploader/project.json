{
  "name": "audio-file-uploader",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/audio-file-uploader/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "dev-e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node dist/apps/audio-file-uploader/main.js",
        "envFile": "apps/audio-file-uploader/.env.e2e-tests"
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "audio-file-uploader:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "audio-file-uploader:build:development"
        },
        "production": {
          "buildTarget": "audio-file-uploader:build:production"
        }
      }
    },
    "semantic-release": {
      "executor": "@theunderscorer/nx-semantic-release:semantic-release"
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash devtools/release/docker-release.sh build audio-file-uploader"
      },
      "dependsOn": ["build", "semantic-release"]
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash devtools/release/docker-release.sh push audio-file-uploader"
      },
      "dependsOn": ["docker-build"]
    },
    "docker-build-preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build . -f ./apps/audio-file-uploader/Dockerfile -t acevedor/$NX_TASK_TARGET_PROJECT:preview --platform linux/amd64"
      },
      "dependsOn": ["build", "test"]
    },
    "deploy-preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker push acevedor/$NX_TASK_TARGET_PROJECT:preview"
      },
      "dependsOn": ["docker-build-preview"]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "configFile": "apps/audio-file-uploader/vite.config.mts",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "{projectRoot}/../../coverage/apps/audio-file-uploader"
      }
    }
  }
}
